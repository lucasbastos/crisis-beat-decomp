{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/hooks/claude_dashboard_reminder.py\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
